# OpenAI-compatible API — never expose secrets to the frontend
# For LM Studio: start the local server and use http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_CHAT_MODEL=qwen2.5-coder-7b-instruct-mlx
OPENAI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@q4_k_m
# Must match document_chunks.embedding vector(N). nomic-embed-text-v1.5 = 768
EMBEDDING_DIMENSIONS=768

# Supabase PostgreSQL + pgvector (service role stays on the backend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# RAG tuning
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.45
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120

# Optional: CORS origin for local Vite frontend
CORS_ORIGIN=http://localhost:5173
